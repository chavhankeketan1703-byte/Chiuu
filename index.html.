<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Valentine's Day, Chiuu</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&family=Quicksand:wght@300;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #fff9f9;
            --accent-pink: #ff8fa3;
            --dark-pink: #c9184a;
            --text-gray: #4a4a4a;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            font-family: 'Quicksand', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
            color: var(--text-gray);
        }

        /* Animated Background */
        .petals {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        header {
            margin-top: 50px;
            text-align: center;
            animation: fadeIn Down 1.5s ease-out;
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 3.5rem;
            color: var(--dark-pink);
            margin-bottom: 10px;
        }

        .container {
            max-width: 600px;
            width: 90%;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(255, 143, 163, 0.2);
            text-align: center;
            animation: scaleIn 1s ease-in-out;
        }

        .bouquet-img {
            width: 100%;
            border-radius: 15px;
            transition: transform 0.3s ease;
        }

        .bouquet-img:hover {
            transform: scale(1.02);
        }

        .message-card {
            margin-top: 30px;
            padding: 25px;
            border-left: 5px solid var(--accent-pink);
            background: #fff0f3;
            border-radius: 0 15px 15px 0;
            font-style: italic;
            line-height: 1.6;
            font-size: 1.2rem;
        }

        .footer {
            margin: 40px 0;
            font-size: 0.9rem;
            opacity: 0.7;
        }

        /* Animations */
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        /* Mobile Optimization */
        @media (max-width: 480px) {
            h1 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>

    <div class="petals" id="petals"></div>

    <header>
        <h1>For You, Chiuu</h1>
        <p>A digital garden of love</p>
    </header>

    <div class="container">
        <img src="your-image-link-here.png" alt="Valentine Bouquet" class="bouquet-img">
        
        <div class="message-card">
            "A little something for now, because one day isn't enough to show you everything I'm feeling. Happy Valentine's."
            <br><br>
            <strong>Sincerely, Your Hubby 😍💖</strong>
        </div>
    </div>

    <div class="footer">
        Made with ❤️ for a special person.
    </div>

    <script>
        // Simple script to create falling hearts/petals
        const petalContainer = document.getElementById('petals');
        function createPetal() {
            const petal = document.createElement('div');
            petal.innerHTML = '❤️';
            petal.style.position = 'absolute';
            petal.style.left = Math.random() * 100 + 'vw';
            petal.style.top = '-20px';
            petal.style.fontSize = (Math.random() * 10 + 10) + 'px';
            petal.style.opacity = Math.random();
            petal.style.transition = `transform ${Math.random() * 3 + 2}s linear, top ${Math.random() * 3 + 2}s linear`;
            
            petalContainer.appendChild(petal);

            setTimeout(() => {
                petal.style.transform = `translateY(100vh) rotate(${Math.random() * 360}deg)`;
                petal.style.top = '100vh';
            }, 10);

            setTimeout(() => {
                petal.remove();
            }, 5000);
        }
        setInterval(createPetal, 300);
    </script>
</body>
</html>
